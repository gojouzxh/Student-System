# Render supplies PORT in production; these defaults are for local development.
PORT=8080
QSP_DATA_DIR=./data
QSP_COOKIE_SECURE=false
QSP_PUBLIC_URL=http://localhost:8080
QSP_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Set true and use an HTTPS URL when deployed behind TLS.
# Configure these only if password-reset email is enabled.
QSP_EMAIL_API_KEY=re_your_resend_api_key
QSP_EMAIL_FROM="Coursework <no-reply@your-domain.example>"
