{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Quiz Server",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/d",
                "/c",
                "npm start"
            ],
            "isBackground": true,
            "problemMatcher": [{
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Quiz & Study Tracker listening on port 8080\\."
                }
            }]
        }
    ]
}